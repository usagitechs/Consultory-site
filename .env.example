# Contact form provider. If the three EmailJS values are set, the form sends through EmailJS
# from the browser (no backend). If any is missing, it posts to the contact API instead.
# In GitHub Actions these come from repository variables EMAILJS_PUBLIC_KEY / EMAILJS_SERVICE_ID / EMAILJS_TEMPLATE_ID.
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=

# Optional: override the contact API endpoint used when EmailJS is not configured.
# PUBLIC_CONTACT_API=https://api.usagiteks.com/contact
