---
import type { Lang } from '../i18n/config';
import dict from '../i18n/sections/about';
import { founders, type Founder } from '../data/founders';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];

const roleFor = (key: Founder['key']) => (key === 'lucas' ? t.roleLucas : t.roleGuido);
const bioFor = (key: Founder['key']) => (key === 'lucas' ? t.bioLucas : t.bioGuido);
---

<section id="nosotros" class="section about" aria-labelledby="nosotros-title">
  <div class="container about__grid">
    <div class="about__intro">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id="nosotros-title" class="section-title">{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
      <div class="about__values">
        <div class="about__value"><span class="about__arrow mono">→</span>{t.value1}</div>
        <div class="about__value"><span class="about__arrow mono">→</span>{t.value2}</div>
        <div class="about__value"><span class="about__arrow mono">→</span>{t.value3}</div>
      </div>
    </div>

    <div class="about__cards">
      {
        founders.map((founder) => (
          <article class="card founder-card reveal">
            <div class="founder-card__avatar" aria-hidden="true">
              {founder.initials}
            </div>
            <div class="founder-card__heading">
              <h3 class="founder-card__name">{founder.name}</h3>
              <p class="founder-card__role mono">{roleFor(founder.key)}</p>
            </div>
            <p class="founder-card__bio">{bioFor(founder.key)}</p>
            <ul class="founder-card__skills">
              {founder.skills.map((skill) => (
                <li class="chip">{skill}</li>
              ))}
            </ul>
            {founder.linkedin && (
              <a
                class="founder-card__linkedin"
                href={founder.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
                {t.linkedinLabel}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7" />
                  <path d="M8 7h9v9" />
                </svg>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
  }

  .about__intro {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about__values {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
    font-size: 15px;
    color: var(--text);
  }

  .about__value {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }

  .about__arrow {
    color: var(--accent-text);
    font-size: 12px;
  }

  .about__cards {
    grid-column: 7 / span 6;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-content: start;
  }

  .founder-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px;
  }

  .founder-card__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: linear-gradient(135deg, #22d3ee, #8b5cf6);
    color: #07090f;
    font-size: 20px;
    font-weight: 800;
  }

  .founder-card__heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .founder-card__name {
    font-size: 19px;
    font-weight: 700;
    color: var(--heading);
  }

  .founder-card__role {
    font-size: 12px;
    color: var(--accent-text);
  }

  .founder-card__bio {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .founder-card__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .founder-card__linkedin {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-text);
  }

  .founder-card__linkedin svg {
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about__intro,
    .about__cards {
      grid-column: auto;
    }
  }

  @media (max-width: 850px) {
    .about__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
