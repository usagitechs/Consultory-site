---
import type { Lang } from '../i18n/config';
import dict from '../i18n/sections/contact';
import { site, contactProvider } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];

const serviceOptions = [
  { value: 'devops', label: t.serviceDevops },
  { value: 'cloud', label: t.serviceCloud },
  { value: 'desarrollo', label: t.serviceDesarrollo },
  { value: 'migraciones', label: t.serviceMigraciones },
  { value: 'soporte', label: t.serviceSoporte },
  { value: 'agentes', label: t.serviceAgentes },
  { value: 'otro', label: t.serviceOtro },
];

// The client script reads the whole dictionary for this language (see Messages in contact-form.ts).
const messages = t;
---

<section id="contacto" class="section section--alt contact" aria-labelledby="contacto-title">
  <div class="container contact__grid">
    <div class="contact__intro">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 id="contacto-title" class="section-title">{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
      <ul class="contact__info">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="M3 7l9 6 9-6" />
          </svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
          <span>{t.hours}</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 19c-4.5 1.5-4.5-2.5-6-3" />
            <path d="M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
          </svg>
          <a href={site.github} target="_blank" rel="noopener noreferrer">github.com/usagitechs</a>
        </li>
      </ul>
    </div>

    <div class="card contact__panel">
      <form
        id="contactForm"
        class="contact__form"
        novalidate
        data-provider={contactProvider}
        data-api={site.contactApi}
        data-emailjs-key={site.emailjs.publicKey}
        data-emailjs-service={site.emailjs.serviceId}
        data-emailjs-template={site.emailjs.templateId}
        data-lang={lang}
      >
        <!-- Honeypot: humans never see it; bots that fill it are dropped silently. -->
        <div class="hp" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="contact__fields">
          <div class="field">
            <label for="contact-name">{t.labelName}</label>
            <input id="contact-name" name="name" type="text" placeholder={t.placeholderName} />
            <p class="field__error" id="contact-name-error" hidden></p>
          </div>
          <div class="field">
            <label for="contact-email">{t.labelEmail}</label>
            <input id="contact-email" name="email" type="email" placeholder={t.placeholderEmail} />
            <p class="field__error" id="contact-email-error" hidden></p>
          </div>
          <div class="field">
            <label for="contact-company">{t.labelCompany}</label>
            <input id="contact-company" name="company" type="text" placeholder={t.placeholderCompany} />
            <p class="field__error" id="contact-company-error" hidden></p>
          </div>
          <div class="field">
            <label for="contact-service">{t.labelService}</label>
            <div class="select-wrap">
              <select id="contact-service" name="service">
                <option value="">{t.servicePlaceholder}</option>
                {serviceOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </div>
            <p class="field__error" id="contact-service-error" hidden></p>
          </div>
        </div>

        <div class="field field--full">
          <label for="contact-message">{t.labelMessage}</label>
          <textarea id="contact-message" name="message" rows="5" placeholder={t.placeholderMessage} />
            <p class="field__error" id="contact-message-error" hidden></p>
        </div>

        <div class="contact__footer">
          {contactProvider === 'api' ? (
            <div class="contact__turnstile">
              <span class="contact__turnstile-note mono">{t.turnstileNote}</span>
              <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-callback="onTurnstileSuccess" data-expired-callback="onTurnstileExpired" data-theme="auto" />
            </div>
          ) : (
            <span class="contact__turnstile-note mono">{t.privacyNote}</span>
          )}
          <button type="submit" class="btn btn--primary">
            {t.submitLabel}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="M13 6l6 6-6 6" />
            </svg>
          </button>
        </div>
      </form>

      <p class="contact__fallback" id="contactFallback" hidden>
        {t.fallbackPrefix}<a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite" hidden>
    <div class="toast__content">
      <span class="toast__icon"></span>
      <span class="toast__message"></span>
    </div>
  </div>
</section>

{contactProvider === 'api' && (
  <script is:inline>
    window.turnstileToken = null;
    window.onTurnstileSuccess = function (token) { window.turnstileToken = token; };
    window.onTurnstileExpired = function () { window.turnstileToken = null; };
  </script>
)}
{contactProvider === 'api' && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>}
<script is:inline type="application/json" id="contactI18n" set:html={JSON.stringify(messages).replace(/</g, '\\u003c')} />

<script>
  import '../scripts/contact-form';
</script>

<style>
  .hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
  }

  .contact__intro {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 12px;
    font-size: 15px;
    color: var(--text);
  }

  .contact__info li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
  }

  .contact__info svg {
    flex-shrink: 0;
    color: var(--accent-text);
  }

  .contact__info a {
    color: inherit;
  }

  .contact__info a:hover {
    color: var(--heading);
  }

  .contact__panel {
    grid-column: 7 / span 6;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }

  .field input,
  .field select,
  .field textarea {
    height: 48px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--input-bg);
    padding: 0 14px;
    font-size: 15px;
    font-family: var(--font-sans);
    color: var(--text);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--placeholder);
  }

  .field textarea {
    height: auto;
    padding: 14px;
    line-height: 1.5;
    resize: vertical;
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap select {
    width: 100%;
    appearance: none;
    padding-right: 36px;
  }

  .select-wrap svg {
    position: absolute;
    top: 50%;
    right: 14px;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }

  .contact__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 4px;
  }

  .contact__turnstile {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact__turnstile-note {
    font-size: 12px;
    color: var(--muted);
  }

  .contact__fallback {
    font-size: 13px;
    color: var(--text-2);
  }

  .contact__fallback a {
    color: var(--accent-text);
  }

  .toast {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 60;
    max-width: 360px;
  }

  .toast[hidden] {
    display: none;
  }

  .toast__content {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--text);
    font-size: 14px;
  }

  .toast__icon {
    display: flex;
    flex-shrink: 0;
  }

  .toast--success .toast__content {
    border-color: rgba(34, 197, 94, 0.4);
  }

  .toast--success .toast__icon {
    color: #22c55e;
  }

  .toast--warning .toast__content {
    border-color: rgba(245, 158, 11, 0.4);
  }

  .toast--warning .toast__icon {
    color: #f59e0b;
  }

  .toast--danger .toast__content {
    border-color: rgba(239, 68, 68, 0.4);
  }

  .toast--danger .toast__icon {
    color: #ef4444;
  }

  @media (max-width: 1024px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .contact__intro,
    .contact__panel {
      grid-column: auto;
    }
  }

  @media (max-width: 480px) {
    .contact__fields {
      grid-template-columns: 1fr;
    }

    .toast {
      right: 16px;
      left: 16px;
      max-width: none;
    }
  }
</style>

<style is:global>
  .contact__spinner {
    animation: contact-spin 0.8s linear infinite;
  }

  @keyframes contact-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
