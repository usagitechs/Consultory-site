---
import type { Lang } from '../i18n/config';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { localizedPath } from '../i18n/utils';
import nav from '../i18n/sections/nav';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = nav[lang];
const year = new Date().getFullYear();
const links = [
  { href: '#servicios', label: t.services },
  { href: '#proceso', label: t.process },
  { href: '#nosotros', label: t.about },
  { href: '#contacto', label: t.contact },
];
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href={localizedPath(lang)} aria-label={site.name}><Image src={logo} alt="" width={22} height={26} densities={[1, 2]} loading="eager" /></a>
      <span class="footer__name">{site.name}</span>
      <span>© <span data-year>{year}</span> · {t.footerRights}</span>
    </div>
    <ul class="footer__links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
      <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding-block: 36px; font-size: 13px; color: var(--muted); }
  .footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .footer__brand { display: flex; align-items: center; gap: 10px; }
  .footer__brand img { width: 22px; height: 26px; object-fit: contain; }
  .footer__name { font-weight: 700; color: var(--text-2); }
  .footer__links { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .footer__links a { color: var(--muted); }
  .footer__links a:hover { color: var(--heading); }
  @media (max-width: 480px) { .footer__inner { flex-direction: column; align-items: flex-start; } .footer__links { gap: 16px; } }
</style>
