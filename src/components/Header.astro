---
import type { Lang } from '../i18n/config';
import { langNames, locales } from '../i18n/config';
import { localizedPath } from '../i18n/utils';
import nav from '../i18n/sections/nav';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = nav[lang];
const links = [
  { href: '#servicios', label: t.services },
  { href: '#proceso', label: t.process },
  { href: '#nosotros', label: t.about },
  { href: '#contacto', label: t.contact },
];
---
<header id="header" class="header">
  <div class="container header__inner">
    <a class="logo" href={localizedPath(lang)} aria-label={site.name}>
      <img src="/logo.png" alt="" width="36" height="43" />
      <span class="logo__text">{site.name}</span>
    </a>

    <nav class="nav" data-nav aria-label="Principal">
      <ul class="nav__list">
        {links.map((l) => (
          <li><a class="nav__link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav__mobile-extra">
        <div class="lang" role="group" aria-label={t.language}>
          {locales.map((l) => (
            <a class:list={['lang__item', { 'is-current': l === lang }]} href={localizedPath(l)} hreflang={l} aria-current={l === lang ? 'page' : undefined} title={langNames[l]}>{l.toUpperCase()}</a>
          ))}
        </div>
        <a class="btn btn--primary nav__cta" href="#contacto">{t.cta}</a>
      </div>
    </nav>

    <div class="header__actions">
      <div class="lang header__lang" role="group" aria-label={t.language}>
        {locales.map((l) => (
          <a class:list={['lang__item', { 'is-current': l === lang }]} href={localizedPath(l)} hreflang={l} aria-current={l === lang ? 'page' : undefined} title={langNames[l]}>{l.toUpperCase()}</a>
        ))}
      </div>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label={t.theme} aria-pressed="false" title={t.theme}>
        <span class="theme-toggle__knob">
          <svg class="theme-toggle__moon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          <svg class="theme-toggle__sun" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="M4.9 4.9l1.4 1.4"></path><path d="M17.7 17.7l1.4 1.4"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="M4.9 19.1l1.4-1.4"></path><path d="M17.7 6.3l1.4-1.4"></path></svg>
        </span>
      </button>

      <a class="btn btn--primary header__cta" href="#contacto">
        {t.cta}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
      </a>

      <button class="burger" type="button" data-nav-toggle aria-label={t.menu} aria-expanded="false" aria-controls="header">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 50; height: var(--header-h); background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--border); transition: background-color var(--ease), box-shadow var(--ease); }
  .header.is-scrolled { box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 100%; }

  .logo { display: flex; align-items: center; gap: 12px; color: var(--heading); }
  .logo img { width: 36px; height: 43px; object-fit: contain; }
  .logo__text { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; }

  .nav__list { display: flex; align-items: center; gap: 36px; }
  .nav__link { font-size: 14px; font-weight: 500; color: var(--text-2); white-space: nowrap; transition: color var(--ease); }
  .nav__link:hover, .nav__link.is-active { color: var(--heading); }
  .nav__mobile-extra { display: none; }

  .header__actions { display: flex; align-items: center; gap: 16px; }
  .header__cta { min-height: 40px; padding: 10px 18px; font-size: 14px; border-radius: 8px; box-shadow: none; white-space: nowrap; }

  .lang { display: flex; align-items: center; gap: 2px; font-family: var(--font-mono); font-size: 12px; }
  .lang__item { padding: 6px 7px; border-radius: 6px; color: var(--muted); transition: color var(--ease), background-color var(--ease); }
  .lang__item:hover { color: var(--heading); }
  .lang__item.is-current { color: var(--heading); background: var(--chip); }

  .theme-toggle { display: flex; align-items: center; width: 46px; height: 26px; padding: 3px; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--surface); transition: background-color var(--ease); }
  .theme-toggle__knob { display: flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; background: var(--accent); color: var(--on-accent); transition: transform var(--ease); }
  .theme-toggle__sun { display: none; }
  :root[data-theme='light'] .theme-toggle__knob { transform: translateX(20px); }
  :root[data-theme='light'] .theme-toggle__moon { display: none; }
  :root[data-theme='light'] .theme-toggle__sun { display: block; }

  .burger { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; align-items: flex-end; }
  .burger span { display: block; height: 2px; width: 22px; background: var(--text); transition: transform var(--ease), opacity var(--ease), width var(--ease); }
  .burger span:nth-child(2) { width: 14px; }

  @media (max-width: 1024px) {
    .header__inner { gap: 16px; }
    .nav__list { gap: 20px; }
    .header__actions { gap: 10px; }
    .header__cta { padding: 10px 14px; }
  }

  @media (max-width: 850px) {
    .header { height: 64px; }
    .logo img { width: 30px; height: 36px; }
    .logo__text { font-size: 17px; }
    .header__cta { display: none; }
    .header__lang { display: none; }
    .burger { display: flex; }
    .nav { position: fixed; inset: 64px 0 0 0; display: flex; flex-direction: column; justify-content: space-between; padding: 32px var(--gutter) 40px; background: var(--bg); border-top: 1px solid var(--border); transform: translateX(100%); visibility: hidden; transition: transform 300ms ease, visibility 0s linear 300ms; overflow-y: auto; }
    .header.is-open .nav { transform: none; visibility: visible; transition: transform 300ms ease; }
    .nav__list { flex-direction: column; align-items: flex-start; gap: 8px; }
    .nav__link { display: block; padding: 12px 0; font-size: 22px; font-weight: 700; color: var(--heading); }
    .nav__mobile-extra { display: flex; flex-direction: column; gap: 20px; padding-top: 24px; border-top: 1px solid var(--border); }
    .nav__mobile-extra .lang { gap: 8px; font-size: 14px; }
    .nav__mobile-extra .lang__item { padding: 10px 14px; }
    .nav__cta { width: 100%; min-height: 52px; }
    .header.is-open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .header.is-open .burger span:nth-child(2) { opacity: 0; }
    .header.is-open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); width: 22px; }
  }
</style>
