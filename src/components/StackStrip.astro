---
import type { Lang } from '../i18n/config';
interface Props { lang: Lang }
const { lang } = Astro.props;
import dict from '../i18n/sections/stack';
import { site } from '../data/site';
const t = dict[lang];
---
<section id="stack" class="stack-strip">
  <div class="container stack-strip__container">
    <span class="stack-strip__label">{t.label}</span>
    <div class="stack-strip__chips">
      {site.cloudProviders.map((provider) => (
        <span class="chip chip--cloud">{provider}</span>
      ))}
      <span class="stack-strip__divider" aria-hidden="true"></span>
      {site.tools.map((tool) => (
        <span class="chip chip--tool">{tool}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-strip {
    position: relative;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stack-strip__container {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-block: 26px;
  }

  .stack-strip__label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .stack-strip__chips {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .stack-strip__divider {
    width: 1px;
    height: 22px;
    background: var(--border-strong);
    margin: 0 6px;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 6px;
    background: var(--surface);
  }

  .chip--cloud {
    color: var(--text);
    border: 1px solid var(--accent-border);
  }

  .chip--tool {
    color: var(--text-2);
    border: 1px solid var(--border);
  }

  @media (max-width: 1024px) {
    .stack-strip__container {
      flex-wrap: wrap;
      row-gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .stack-strip__container {
      gap: 16px;
      padding-block: 20px;
    }
  }
</style>
