---
// Self-hosted variable fonts: no request to Google, no IP disclosure, no render-blocking third-party CSS.
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import type { Lang } from '../i18n/config';
import { langTags, defaultLang } from '../i18n/config';
import { alternates, localizedPath } from '../i18n/utils';
import meta from '../i18n/sections/meta';
import nav from '../i18n/sections/nav';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = meta[lang];
const n = nav[lang];
const canonical = new URL(localizedPath(lang), site.url).href;
const ogImage = new URL('/og.png', site.url).href;
---
<!doctype html>
<html lang={langTags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Content Security Policy (GitHub Pages cannot send HTTP headers, so it lives here; frame-ancestors is
      not supported via <meta>). script-src allows: our bundled scripts ('self'), the inline theme bootstrap
      below by hash (recompute if its text changes: sha256 of the exact script body as built), EmailJS's
      dynamic import (bundled, 'self'), and Cloudflare Turnstile in API mode. Fonts are self-hosted.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'sha256-e//vqr9nMiq8KghfS8nvyaJ5My7bTLRQWR4GQPrCQbQ=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.emailjs.com https://api.usagiteks.com; frame-src https://challenges.cloudflare.com; base-uri 'none'; object-src 'none'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {alternates().map((a) => (
      <link rel="alternate" hreflang={langTags[a.lang]} href={new URL(a.href, site.url).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(defaultLang), site.url).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.ogTitle} />
    <meta property="og:description" content={t.ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={langTags[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#07090f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />


    <!-- Apply the saved or system theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('usagiteks-theme'); } catch (e) {}
        var theme = saved === 'light' || saved === 'dark'
          ? saved
          : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{n.skip}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/theme';
      import '../scripts/nav';
    </script>
  </body>
</html>

<style>
  .skip-link { position: absolute; left: 16px; top: -60px; z-index: 100; padding: 10px 14px; border-radius: 8px; background: var(--accent); color: var(--on-accent); font-weight: 700; }
  .skip-link:focus { top: 16px; }
</style>
